{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/cultura-GH/", "permanent": false }],
  "rewrites": [
    { "source": "/cultura-GH", "destination": "/index.html" },
    { "source": "/cultura-GH/", "destination": "/index.html" },
    { "source": "/cultura-GH/:path+", "destination": "/:path+" }
  ]
}
